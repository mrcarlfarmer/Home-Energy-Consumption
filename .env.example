# Uses the reserved Pi address and chosen hostname. Review secret paths before copying to .env.
# This is the protected HTTPS Compose example. For no-login HTTP, see docs/portainer-http-installation.md.
LAN_BIND_ADDRESS=192.168.1.2
APP_ALLOWED_HOSTS=home.energy,192.168.1.2
APP_ALLOWED_ORIGINS=https://home.energy:8443,https://192.168.1.2:8443
ADMIN_PASSWORD_SECRET_FILE=./secrets/admin-password
TLS_CERTIFICATE_FILE=./secrets/energy.pem
TLS_PRIVATE_KEY_FILE=./secrets/energy-key.pem
# Must be a mounted, dedicated filesystem <= the budget, not an ordinary directory.
# See docs/storage-management.md before upgrading an existing deployment.
ENERGY_DATA_DIRECTORY=/srv/home-energy/data
APP_STORAGE_BUDGET_BYTES=2147483648
APP_STORAGE_RESERVE_BYTES=268435456
APP_RAW_RETENTION_DAYS=30
APP_5M_RETENTION_DAYS=396
APP_DAILY_RETENTION_DAYS=3653
APP_RECOVERY_LOOKBACK_DAYS=1
