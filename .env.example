# Copy to .env and replace the example address/hostnames and secret paths.
LAN_BIND_ADDRESS=192.168.1.50
APP_ALLOWED_HOSTS=energy.home.arpa,192.168.1.50
APP_ALLOWED_ORIGINS=https://energy.home.arpa:8443,https://192.168.1.50:8443
ADMIN_PASSWORD_SECRET_FILE=./secrets/admin-password
TLS_CERTIFICATE_FILE=./secrets/energy.pem
TLS_PRIVATE_KEY_FILE=./secrets/energy-key.pem
